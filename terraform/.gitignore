# Ignore Terraform state files
*.tfstate
*.tfstate.backup

# Ignore the .terraform directory (where modules/plugins are downloaded)
.terraform/

# Ignore crash logs
crash.log

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore Terraform variable files that may contain secrets
terraform.tfvars
*.tfvars

# Ignore .terraform.lock.hcl if you don't want to track it (optional)
#.terraform.lock.hcl
